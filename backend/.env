NODE_ENV=development
PORT=8000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/workzarr

# JWT Secrets (used by jwtUtils — must match what server.js/jwt.js reads)
JWT_ACCESS_SECRET=workzarr_access_secret_min_32_chars_long_2026
JWT_REFRESH_SECRET=workzarr_refresh_secret_min_32_chars_long_2026
JWT_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Google OAuth (fill in when you have credentials)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Cloudinary (mocked for dev)
CLOUDINARY_CLOUD_NAME=mock_cloud
CLOUDINARY_API_KEY=mock_key
CLOUDINARY_API_SECRET=mock_secret

# Razorpay TEST keys
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_placeholder
RAZORPAY_WEBHOOK_SECRET=mock_webhook_secret

# MSG91 SMS (empty = logs OTP to console in dev)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=MOCK_TEMPLATE
MSG91_SENDER_ID=MOCK

# Firebase (empty = disabled in dev)
FIREBASE_SERVICE_ACCOUNT=

# Email (mocked for dev)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASS=mock_pass
FROM_EMAIL=noreply@workzarr.com

# CORS & Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
COOKIE_SECRET=workzarr_dev_cookie_secret_99
